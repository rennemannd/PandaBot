{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Modular Discord bot with music playback",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/register-commands.ts",
    "postinstall": "node scripts/patch-yt-dlp.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/yt-dlp": "^2.0.1",
    "discord.js": "^14.16.0",
    "distube": "^5.0.2",
    "dotenv": "^16.4.0",
    "ffmpeg-static": "^5.2.0",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
